<%# locals: (current_total:, previous_total:, change:, current_period:, previous_period:) %>

<section id="monthly-spending" aria-labelledby="monthly-spending-heading" class="bg-container p-4 rounded-xl shadow-border-xs space-y-4">
  <h2 id="monthly-spending-heading" class="text-lg font-medium text-primary">Monthly spending</h2>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="space-y-1">
      <p class="text-sm text-secondary">This month · <%= current_period.start_date.strftime("%B %Y") %> (month to date)</p>
      <p class="text-2xl font-medium text-primary" data-testid="current-month-spending"><%= format_money(Money.new(current_total, Current.family.currency)) %></p>
    </div>

    <div class="space-y-1">
      <p class="text-sm text-secondary">Last month · <%= previous_period.start_date.strftime("%B %Y") %></p>
      <p class="text-2xl font-medium text-primary" data-testid="previous-month-spending"><%= format_money(Money.new(previous_total, Current.family.currency)) %></p>
    </div>

    <div class="space-y-1">
      <p class="text-sm text-secondary">Change vs. last month</p>
      <p class="text-lg font-medium <%= change.nil? || change.zero? ? "text-secondary" : (change.positive? ? "text-destructive" : "text-success") %>" data-testid="spending-change">
        <% if change.nil? %>
          N/A · No spending last month
        <% elsif change.zero? %>
          <%= number_to_percentage(0, precision: 1) %> · No change
        <% else %>
          <%= number_to_percentage(change.abs, precision: 1) %> <%= change.positive? ? "more" : "less" %>
        <% end %>
      </p>
    </div>
  </div>
</section>
